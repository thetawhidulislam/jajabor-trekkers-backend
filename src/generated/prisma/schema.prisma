generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DestinationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

enum TripStatus {
  PLANNING
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum TripMemberRole {
  OWNER
  MEMBER
}

enum TripMemberStatus {
  PENDING
  ACCEPTED
}

enum ExpenseCategory {
  TRANSPORT
  FOOD
  STAY
  ACTIVITY
  GEAR
  OTHER
}

model User {
  id            String   @id
  name          String?
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          Role     @default(USER)
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts             Account[]
  sessions             Session[]
  verifications        Verification[]
  destinations         Destination[]  @relation("DestinationCreatedBy")
  trips                Trip[]         @relation("TripOwner")
  tripMemberships      TripMember[]
  expenses             Expense[]      @relation("ExpensePaidBy")
  expenseSplits        ExpenseSplit[]
  settlementsSent      Settlement[]   @relation("SettlementFromUser")
  settlementsReceived  Settlement[]   @relation("SettlementToUser")
  packingItemsAssigned PackingItem[]  @relation("PackingItemAssignedTo")
  packingItemsAdded    PackingItem[]  @relation("PackingItemAddedBy")
  reviews              Review[]

  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([userId])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destinations Destination[]

  @@index([name])
}

model Destination {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  division           String
  district           String?
  locationText       String?
  latitude           Float?
  longitude          Float?
  description        String
  coverImage         String
  estimatedCostMin   Decimal           @db.Decimal(12, 2)
  estimatedCostMax   Decimal           @db.Decimal(12, 2)
  recommendedDays    Int
  bestTimeToVisit    String?
  activities         String[]
  difficulty         Difficulty        @default(EASY)
  safetyNotes        String?
  permissionRequired Boolean           @default(false)
  permissionNote     String?
  lastVerifiedAt     DateTime?
  status             DestinationStatus @default(DRAFT)
  isFeatured         Boolean           @default(false)
  avgRating          Float             @default(0)
  reviewCount        Int               @default(0)
  categoryId         String
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  category Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator  User               @relation("DestinationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  images   DestinationImage[]
  gear     DestinationGear[]
  trips    Trip[]
  reviews  Review[]

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([difficulty])
  @@index([isFeatured])
  @@index([avgRating])
}

model DestinationImage {
  id            String   @id @default(cuid())
  destinationId String
  url           String
  publicId      String?
  caption       String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId, sortOrder])
}

model GearItem {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  imageUrl    String?
  externalUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  destinationGear DestinationGear[]
  packingItems    PackingItem[]

  @@index([category])
  @@index([name])
}

model DestinationGear {
  destinationId String
  gearItemId    String
  isEssential   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  gearItem    GearItem    @relation(fields: [gearItemId], references: [id], onDelete: Cascade)

  @@id([destinationId, gearItemId])
  @@index([destinationId])
  @@index([gearItemId])
}

model Trip {
  id            String     @id @default(cuid())
  title         String
  destinationId String?
  startDate     DateTime
  endDate       DateTime
  budget        Decimal?   @db.Decimal(12, 2)
  status        TripStatus @default(PLANNING)
  notes         String?
  ownerId       String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  destination    Destination?    @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  owner          User            @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members        TripMember[]
  itineraryItems ItineraryItem[]
  packingItems   PackingItem[]
  expenses       Expense[]
  settlements    Settlement[]

  @@index([destinationId])
  @@index([ownerId])
  @@index([status])
  @@index([startDate])
}

model TripMember {
  id        String           @id @default(cuid())
  tripId    String
  userId    String
  role      TripMemberRole   @default(MEMBER)
  status    TripMemberStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@index([status])
}

model ItineraryItem {
  id            String   @id @default(cuid())
  tripId        String
  dayNumber     Int
  startTime     String?
  title         String
  description   String?
  location      String?
  estimatedCost Decimal? @db.Decimal(12, 2)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([dayNumber])
  @@index([sortOrder])
}

model PackingItem {
  id           String   @id @default(cuid())
  tripId       String
  name         String
  category     String?
  quantity     Int      @default(1)
  isPacked     Boolean  @default(false)
  gearItemId   String?
  assignedToId String?
  addedById    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  gearItem   GearItem? @relation(fields: [gearItemId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("PackingItemAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  addedBy    User      @relation("PackingItemAddedBy", fields: [addedById], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([assignedToId])
  @@index([isPacked])
  @@index([addedById])
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  category    ExpenseCategory @default(OTHER)
  paidById    String
  expenseDate DateTime
  note        String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  trip   Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy User           @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  splits ExpenseSplit[]

  @@index([tripId])
  @@index([paidById])
  @@index([expenseDate])
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  expenseId String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model Settlement {
  id         String   @id @default(cuid())
  tripId     String
  fromUserId String
  toUserId   String
  amount     Decimal  @db.Decimal(12, 2)
  settledAt  DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser User @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser   User @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([tripId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([settledAt])
}

model Review {
  id            String   @id @default(cuid())
  destinationId String
  userId        String
  rating        Int
  comment       String?
  isHidden      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([destinationId, userId])
  @@index([destinationId])
  @@index([userId])
  @@index([rating])
}
